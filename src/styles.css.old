/* You can add global styles to this file, and also import other style files */
@import "~@angular/material/prebuilt-themes/indigo-pink.css";
@import '~bootstrap/dist/css/bootstrap.min.css';

html, body {
  height: 100%;
  margin: 0;
  font-family: 'Roboto', "Helvetica Neue", sans-serif;
  background: linear-gradient(135deg, #f0f4f8, #dfe9f3);
  color: #333;
}

/* Container Styling */
.container {
  padding: 50px;
  max-width: 1200px;
  margin: auto;
  background-color: #ffffff;
  box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
  border-radius: 12px;
}

.container-sm {
  padding: 50px;
  max-width: 800px;
  margin: auto;
  background-color: #ffffff;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.08);
  border-radius: 10px;
}

/* Typography Alignment */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

/* Enhanced Anchor Tag */
a {
  position: relative;
  display: inline-block;
  padding: 15px 30px;
  border: 2px solid #ffffff;
  color: #ffffff;
  background-color: #6c63ff;
  text-transform: uppercase;
  text-decoration: none;
  font-weight: 600;
  font-size: 18px;
  overflow: hidden;
  transition: all 0.3s ease-in-out;
  border-radius: 8px;
}

a::before,
a::after {
  content: '';
  position: absolute;
  background-color: #4527a0;
  transition: transform 0.3s ease-in-out;
  z-index: 1;
}

a::before {
  top: 6px;
  left: -2px;
  width: calc(100% + 4px);
  height: calc(100% - 12px);
  transform: scaleY(1);
}

a::after {
  left: 6px;
  top: -2px;
  height: calc(100% + 4px);
  width: calc(100% - 12px);
  transform: scaleX(1);
  transition-delay: 0.5s;
}

a:hover::before {
  transform: scaleY(0);
}

a:hover::after {
  transform: scaleX(0);
}

a span {
  position: relative;
  z-index: 2;
}

/* Button Reset & Styling */
button {
  background: #6200ea;
  color: #fff;
  padding: 12px 24px;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  transition: background 0.3s ease-in-out;
}

button:hover {
  background: #3700b3;
}
